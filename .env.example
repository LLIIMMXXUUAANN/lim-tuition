# Copy this file to .env.local and fill in your values
# Get these from: https://supabase.com -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini API — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Google Drive + Calendar integration — get from https://console.cloud.google.com
# Create an OAuth 2.0 Client ID (Web application), enable Drive API + Calendar API
# Add yourself as a test user in OAuth consent screen
# After deploying, visit /api/google/auth once to store the refresh token
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_STUDENTS_FOLDER_ID=your-google-drive-students-folder-id
GOOGLE_LEC_TOPIC1_FILE_ID=your-google-drive-topic1-pptx-file-id
# Google Calendar: Settings → click your calendar → Integrate calendar → Calendar ID
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# LangSmith tracing (optional) — get from https://smith.langchain.com → Settings → API Keys
# Set LANGCHAIN_TRACING=true to enable; traces appear in the LangSmith web UI
LANGCHAIN_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=tuition-agent
