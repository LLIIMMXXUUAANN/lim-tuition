# Copy this file to .env.local and fill in your values
# Get these from: https://supabase.com -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# FastAPI backend — must match INTERNAL_API_SECRET in tuition-api/.env
# local: http://127.0.0.1:8000 | production: https://tuition-api-uqq4.onrender.com
FASTAPI_BASE_URL=http://127.0.0.1:8000
INTERNAL_API_SECRET=your-shared-secret-here

# LangSmith tracing (optional) — get from https://smith.langchain.com → Settings → API Keys
# Set LANGCHAIN_TRACING=true to enable; traces appear in the LangSmith web UI
LANGCHAIN_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=tuition-agent

# Note: GEMINI_API_KEY and all GOOGLE_* vars have moved to tuition-api/.env (FastAPI owns the Google/Gemini integrations)
