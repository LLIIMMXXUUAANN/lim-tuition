# Copy this file to .env.local and fill in your values
# Get these from: https://supabase.com -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# FastAPI backend — must match INTERNAL_API_SECRET in tuition-api/.env
# local: http://127.0.0.1:8000 | production: https://tuition-api-uqq4.onrender.com
FASTAPI_BASE_URL=http://127.0.0.1:8000
INTERNAL_API_SECRET=your-shared-secret-here

# Note: GEMINI_API_KEY, all GOOGLE_* vars, and LangSmith tracing vars have moved to tuition-api/.env (FastAPI owns the Google/Gemini/LangGraph integrations)
